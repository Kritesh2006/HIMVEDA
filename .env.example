# ─────────────────────────────────────────────────────────────
# HIMVEDA V2 — environment template
# Copy to .env.local and fill in. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon / Supabase / RDS / local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/himveda

# Canonical public origin (used for canonical tags, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://himvedanepal.com

# Server-only secret used to pepper admin access-code hashes and
# to sign nothing else. 32+ random bytes, e.g. `openssl rand -hex 32`.
# Rotating it invalidates every registered access code (re-run admin:register).
ADMIN_CODE_PEPPER=<set privately>

# Admin access codes are ONLY read by `npm run admin:register`, which
# stores salted scrypt hashes in the database. The running app never
# reads these variables. Remove them from the environment after registering.
ADMIN_CODE_1=<set privately>
ADMIN_CODE_2=<set privately>
ADMIN_CODE_3=<set privately>

# Live FX provider (optional). Without it the app uses the documented
# development rates in src/server/currency/dev-rates.ts and labels them.
# Supported: "exchangerate-api" (https://www.exchangerate-api.com)
FX_PROVIDER=
FX_API_KEY=

# Protects /api/cron/* endpoints (Vercel Cron sends it as a Bearer token)
CRON_SECRET=<set privately>

# Optional: trust this platform's geolocation header for country detection.
# "vercel" → x-vercel-ip-country, "cloudflare" → cf-ipcountry, "none" → off
GEO_HEADER_SOURCE=vercel
